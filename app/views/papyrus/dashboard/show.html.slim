.grid.grid-cols-1.gap-4.sm:grid-cols-3
  .col-span-3.sm:col-span-3

    = sts.card :papyrus_papers, icon: 'fad fa-scroll' do |card|
      - card.with_tab :papers, padding: false
        = table("papyrus/papers", params: request.query_parameters.slice("template_id").merge(papyrable: @papyrable))
      - card.with_tab :print_jobs, padding: false
        = table("papyrus/print_jobs", params: {})
